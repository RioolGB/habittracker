# Сервер
PORT=5001
NODE_ENV=development

# База данных PostgreSQL
DATABASE_URL=postgres://habittracker:habittracker@localhost:5432/habittracker

# Redis (кэширование сессий / refresh-токенов)
REDIS_URL=redis://localhost:6379
# Если Redis недоступен — используется in-memory хранилище (режим разработки)

# JWT
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Уведомления
# ENABLE_REMINDERS=false — включить планировщик напоминаний (push/email)
ENABLE_REMINDERS=false

# Email (опционально). Если ключ не задан — письма логируются в консоль.
RESEND_API_KEY=
EMAIL_FROM=HabitTracker <noreply@example.com>

# Web Push (Web Push API). Нужны VAPID-ключи (npm run via web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com

# CORS (фронтенд)
FRONTEND_URL=http://localhost:5173